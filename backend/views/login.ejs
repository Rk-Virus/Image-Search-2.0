<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login</title>
  <style>
    body { font-family: Arial, sans-serif; padding: 2rem; background:#f7f7f7 }
    .card { background:#fff; padding:1.5rem; border-radius:8px; max-width:420px; margin:0 auto; box-shadow:0 2px 8px rgba(0,0,0,.06) }
    .form-group { margin-bottom:1rem }
    label { display:block; margin-bottom:.25rem; font-weight:600 }
    input { width:100%; padding:.5rem 0; border:1px solid #ddd; border-radius:4px }
    button { padding:.6rem 1rem; border:none; background:#007bff; color:#fff; border-radius:4px; cursor:pointer }
    .actions { display:flex; justify-content:space-between; align-items:center; margin-top:.5rem }
    a { color:#007bff; text-decoration:none }
    .google-btn {
      width: 100%;
      padding: .6rem 0rem;
      background: #fff;
      border: 1px solid #ddd;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      cursor: pointer;
      margin-top: 1rem;
    }
    .google-btn img {
      width: 20px;
      height: 20px;
    }
    .divider {
      text-align: center;
      margin: 1rem 0;
      position: relative;
    }
    .divider::before, .divider::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 45%;
      height: 1px;
      background: #ddd;
    }
    .divider::before { left: 0; }
    .divider::after { right: 0; }
  </style>
</head>
<body>
  <div class="card">
    <h2>Sign in</h2>

    <!-- optional server error/message -->
    <% if (typeof error !== 'undefined' && error) { %>
      <div style="color:#b00020; margin-bottom:1rem"><%= error %></div>
    <% } %>

   

    <form action="/api/auth/login" method="POST" novalidate>
      <div class="form-group">
        <label for="email">Email address</label>
        <input id="email" name="username" type="email" required placeholder="you@example.com" />
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required placeholder="Your password" />
      </div>

      <div class="form-group actions">
        <label style="font-weight:400">
          <input type="checkbox" name="remember" value="1" /> Remember me
        </label>
        <a href="/forgot">Forgot?</a>
      </div>

      <div class="form-group">
        <button type="submit">Log in</button>
      </div>

      <p style="text-align:center; margin-top:.5rem">Don't have an account? <a href="/register">Register</a></p>
    </form>
    
    <div class="divider">or</div>

     <!-- Google Sign In Button -->
    <a href="/api/auth/google" class="google-btn">
      <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/Google_%22G%22_Logo.svg" alt="Google logo">
      Continue with Google
    </a>

  </div>
</body>
</html>